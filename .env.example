# === YouTube Outlier + Strategie Kit — Konfiguration ===
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# (.env ist über .gitignore geschützt und landet NIE im Repo.)

# YouTube Data API v3 Key — für echte YouTube-Daten.
# Holen: https://console.cloud.google.com → "YouTube Data API v3" aktivieren → Anmeldedaten → API-Schlüssel
# Ohne Key läuft alles über den yt-dlp-Fallback (langsamer, keine Abo-Zahlen).
YOUTUBE_API_KEY=

# Pfad zu deinem Obsidian-Vault — für die Obsidian-Anbindung des Strategie-Skills.
# Beispiel: /Users/deinname/Documents/MeinVault
OBSIDIAN_VAULT_PATH=
